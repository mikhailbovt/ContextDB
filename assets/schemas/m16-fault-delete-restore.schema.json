{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/m16-fault-delete-restore/v1.json",
  "title": "ContextDB M16 fault, deletion, and restore receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "generated_at",
    "status",
    "frozen_inputs",
    "acknowledged_durability",
    "semantic_atomicity",
    "deletion",
    "backup_restore",
    "test_runs",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "contextdb.m16-fault-delete-restore/v1"},
    "milestone": {"const": "M16"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/status"
    },
    "frozen_inputs": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/frozenInputs"
    },
    "acknowledged_durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledged_commits", "acknowledged_commits_recovered", "acknowledged_loss", "passed"],
      "properties": {
        "acknowledged_commits": {"type": "integer", "minimum": 1},
        "acknowledged_commits_recovered": {"type": "integer", "minimum": 0},
        "acknowledged_loss": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "semantic_atomicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partial_publications_observed", "checks", "passed"],
      "properties": {
        "partial_publications_observed": {"type": "integer", "minimum": 0},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/check"
          }
        },
        "passed": {"type": "boolean"}
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_target_classes", "dispositions", "all_dispositions_verified", "passed"],
      "properties": {
        "required_target_classes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/deletionTarget"}
        },
        "dispositions": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "disposition", "verified"],
            "properties": {
              "target": {"$ref": "#/$defs/deletionTarget"},
              "disposition": {
                "enum": [
                  "verified_deleted",
                  "verified_absent",
                  "verified_retained_with_expiry",
                  "not_applicable_verified",
                  "unverified",
                  "failed"
                ]
              },
              "verified": {"type": "boolean"},
              "receipt": {
                "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/artifact"
              },
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "all_dispositions_verified": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "backup_restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "passed"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/check"
          }
        },
        "passed": {"type": "boolean"}
      }
    },
    "test_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "environment", "command", "exit_code", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
          "environment": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "status": {"enum": ["passed", "failed", "error", "not_run"]},
          "artifact": {
            "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/artifact"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/artifact"
      }
    },
    "limitations": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/limitations"
    }
  },
  "$defs": {
    "deletionTarget": {
      "enum": [
        "primary_content",
        "episode",
        "evidence",
        "semantic_memory",
        "summary",
        "embedding",
        "ann_index",
        "lexical_index",
        "cache",
        "checkpoint_or_handoff",
        "provider_copy",
        "export",
        "backup"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/release-bundle-input/v1.json",
  "title": "ContextDB offline release bundle input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source",
    "version_manifest",
    "proof_index",
    "artifacts",
    "supporting_files",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.release-bundle-input/v1"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "created_at"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "channel": {
          "enum": ["development", "alpha", "beta", "stable"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "candidate": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_commit", "dirty"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "version_manifest": {
      "$ref": "#/$defs/inputFile"
    },
    "proof_index": {
      "$ref": "#/$defs/inputFile"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "supporting_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportingFile"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        }
      }
    },
    "supportingFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "path",
        "sha256",
        "size_bytes",
        "media_type",
        "purpose"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "purpose": {
          "enum": [
            "build-recipe",
            "proof",
            "roadmap-ledger",
            "license",
            "notice",
            "documentation",
            "metadata"
          ]
        }
      }
    },
    "relatedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_path",
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sbom",
            "install-receipt",
            "provenance-attestation",
            "publication-receipt",
            "license",
            "notice"
          ]
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "platform": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_level": {
          "enum": ["static", "runtime", "publication"]
        },
        "status": {
          "enum": ["passed", "failed", "not-run"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "builder", "build_recipe", "reproducible"],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "builder": {
          "type": "string",
          "minLength": 1
        },
        "build_recipe": {
          "$ref": "#/$defs/relativePath"
        },
        "reproducible": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package_id",
        "roles",
        "kind",
        "source_path",
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "targets",
        "version",
        "provenance",
        "related_files"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "package_id": {
          "$ref": "#/$defs/identifier"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "related_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedFile"
          }
        }
      }
    }
  }
}

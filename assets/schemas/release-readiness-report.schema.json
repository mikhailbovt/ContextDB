{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/release-readiness-report/v1.json",
  "title": "ContextDB release readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verifier_version",
    "stage",
    "target_milestone",
    "target_exit",
    "roadmap_revision",
    "inputs",
    "dependency_closure",
    "unresolved_milestones",
    "unresolved_exit_criteria",
    "required_proofs",
    "required_packages",
    "external_requirements",
    "summary",
    "release_ready",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.release-readiness-report/v1"
    },
    "verifier_version": {"$ref": "#/$defs/semver"},
    "stage": {
      "enum": ["alpha", "beta", "stable"]
    },
    "target_milestone": {
      "enum": ["M18", "M19"]
    },
    "target_exit": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/exitId"}
      ]
    },
    "roadmap_revision": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger", "package_matrix"],
      "properties": {
        "ledger": {
          "$ref": "#/$defs/fileReference"
        },
        "package_matrix": {
          "$ref": "#/$defs/fileReference"
        }
      }
    },
    "dependency_closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/milestoneId"
      }
    },
    "unresolved_milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/milestoneId"
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved_exit_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "milestone", "text", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/exitId"
          },
          "milestone": {
            "$ref": "#/$defs/milestoneId"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "kind",
          "path",
          "present",
          "sha256",
          "presence_is_pass"
        ],
        "properties": {
          "milestone": {
            "$ref": "#/$defs/milestoneId"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "present": {
            "type": "boolean"
          },
          "sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "presence_is_pass": {
            "const": false
          }
        }
      }
    },
    "required_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "current_state",
          "missing_source_paths",
          "artifact_targets_required",
          "runtime_install_receipts_required",
          "artifact_manifest_entry_present",
          "publication_receipt_present",
          "release_requirement_satisfied"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "current_state": {
            "type": "string",
            "minLength": 1
          },
          "missing_source_paths": {
            "$ref": "#/$defs/stringArray"
          },
          "artifact_targets_required": {
            "$ref": "#/$defs/stringArray"
          },
          "runtime_install_receipts_required": {
            "$ref": "#/$defs/stringArray"
          },
          "artifact_manifest_entry_present": {
            "type": "boolean"
          },
          "publication_receipt_present": {
            "type": "boolean"
          },
          "release_requirement_satisfied": {
            "type": "boolean"
          }
        }
      }
    },
    "external_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": ["unproven", "not-run", "passed", "failed"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_milestones",
        "unresolved_milestones",
        "unresolved_exit_criteria",
        "required_proofs",
        "present_required_proof_files",
        "required_packages",
        "packages_satisfying_release_requirement"
      ],
      "properties": {
        "dependency_milestones": {
          "$ref": "#/$defs/count"
        },
        "unresolved_milestones": {
          "$ref": "#/$defs/count"
        },
        "unresolved_exit_criteria": {
          "$ref": "#/$defs/count"
        },
        "required_proofs": {
          "$ref": "#/$defs/count"
        },
        "present_required_proof_files": {
          "$ref": "#/$defs/count"
        },
        "required_packages": {
          "$ref": "#/$defs/count"
        },
        "packages_satisfying_release_requirement": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "release_ready": {
      "const": false
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_status_is_authoritative",
        "proof_file_presence_is_gate_pass",
        "source_presence_is_package_install_proof",
        "docker_runtime_executed",
        "publication_checked"
      ],
      "properties": {
        "ledger_status_is_authoritative": {
          "const": true
        },
        "proof_file_presence_is_gate_pass": {
          "const": false
        },
        "source_presence_is_package_install_proof": {
          "const": false
        },
        "docker_runtime_executed": {
          "const": false
        },
        "publication_checked": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "milestoneId": {
      "type": "string",
      "pattern": "^M(?:[0-9]|1[0-9])$"
    },
    "exitId": {
      "type": "string",
      "pattern": "^M(?:[0-9]|1[0-9])-E[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}

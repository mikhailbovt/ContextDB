{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/m16-process-kill/v1.json",
  "title": "ContextDB M16 process-kill fault matrix receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "generated_at",
    "status",
    "frozen_inputs",
    "environment",
    "backend",
    "durability",
    "command",
    "source_artifacts",
    "cases",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "contextdb.m16-process-kill/v1"},
    "milestone": {"const": "M16"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/status"
    },
    "frozen_inputs": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/frozenInputs"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "rust_toolchain", "execution"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "rust_toolchain": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1}
      }
    },
    "backend": {"type": "string", "minLength": 1},
    "durability": {"const": "sync"},
    "command": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/artifact"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "child_reached_barrier",
          "child_was_terminated",
          "reopened",
          "expected_value_visible",
          "head_sequence",
          "deep_verify_records",
          "status"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "child_reached_barrier": {"type": "boolean"},
          "child_was_terminated": {"type": "boolean"},
          "reopened": {"type": "boolean"},
          "expected_value_visible": {"type": "boolean"},
          "head_sequence": {"type": "integer", "minimum": 0},
          "deep_verify_records": {"type": "integer", "minimum": 0},
          "status": {"enum": ["passed", "failed", "error"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledged_commits", "acknowledged_commits_recovered", "acknowledged_loss"],
      "properties": {
        "acknowledged_commits": {"type": "integer", "minimum": 1},
        "acknowledged_commits_recovered": {"type": "integer", "minimum": 0},
        "acknowledged_loss": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {
      "$ref": "https://contextdb.dev/schemas/m16-proof-common/v1.json#/$defs/limitations"
    }
  }
}

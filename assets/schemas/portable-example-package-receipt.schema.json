{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/portable-example-package-receipt/v1.json",
  "title": "ContextDB portable example package receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packager_version",
    "output",
    "size_bytes",
    "sha256",
    "entries",
    "determinism",
    "release_ready"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.portable-example-package-receipt/v1"
    },
    "packager_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "output": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.zip$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "$ref": "#/$defs/digest"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_order", "timestamp", "unix_mode", "compression"],
      "properties": {
        "entry_order": {
          "const": "utf8-bytewise"
        },
        "timestamp": {
          "const": "1980-01-01T00:00:00Z"
        },
        "unix_mode": {
          "const": "0644"
        },
        "compression": {
          "const": "deflate-9"
        }
      }
    },
    "release_ready": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

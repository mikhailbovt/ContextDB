{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/release-proof-index/v1.json",
  "title": "ContextDB release proof index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "release_stage",
    "generated_at",
    "ledger",
    "milestones",
    "known_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.release-proof-index/v1"
    },
    "release_version": {
      "$ref": "#/$defs/semver"
    },
    "release_stage": {
      "enum": ["development", "alpha", "beta", "stable"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "roadmap_revision"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roadmap_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "reason", "blocking"],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^M(?:[0-9]|1[0-9])-E[0-9]{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "evidence_level"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_level": {
          "enum": ["source", "static", "runtime", "platform-runtime", "publication", "manual-review"]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "public_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "exitCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M(?:[0-9]|1[0-9])-E[0-9]{2}$"
        },
        "status": {
          "enum": ["not-started", "in-progress", "blocked", "passed", "failed", "waived"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "exit_criteria", "required_proofs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M(?:[0-9]|1[0-9])$"
        },
        "status": {
          "enum": ["not-started", "in-progress", "blocked", "passed", "failed", "waived"]
        },
        "exit_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exitCriterion"
          }
        },
        "required_proofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

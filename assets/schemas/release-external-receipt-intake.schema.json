{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/release-external-receipt-intake/v1.json",
  "title": "ContextDB accepted external release receipt intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "generated_at",
    "release_version",
    "subject_manifest",
    "receipt_set",
    "entries",
    "coverage",
    "checks",
    "accepted",
    "release_ready",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.release-external-receipt-intake/v1"
    },
    "tool_version": {"$ref": "#/$defs/semver"},
    "generated_at": {"type": "string", "format": "date-time"},
    "release_version": {"$ref": "#/$defs/semver"},
    "subject_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "source_commit"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "receipt_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_path",
          "sha256",
          "size_bytes",
          "artifact_id",
          "platform",
          "status"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "kind": {"$ref": "#/$defs/kind"},
          "source_path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "artifact_id": {"$ref": "#/$defs/identifier"},
          "platform": {"$ref": "#/$defs/identifier"},
          "status": {"const": "accepted"}
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "platform", "complete"],
        "properties": {
          "artifact_id": {"$ref": "#/$defs/identifier"},
          "kind": {"$ref": "#/$defs/kind"},
          "platform": {"$ref": "#/$defs/identifier"},
          "complete": {"const": true}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "status": {"const": "passed"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "accepted": {"const": true},
    "release_ready": {"const": false},
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_accessed",
        "runtime_executed",
        "files_copied",
        "signatures_created",
        "live_publication_retrieval_performed",
        "release_readiness_decided_by_intake"
      ],
      "properties": {
        "network_accessed": {"const": false},
        "runtime_executed": {"const": false},
        "files_copied": {"const": false},
        "signatures_created": {"const": false},
        "live_publication_retrieval_performed": {"const": false},
        "release_readiness_decided_by_intake": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "kind": {
      "enum": [
        "install-receipt",
        "operational-receipt",
        "publication-receipt",
        "provenance-attestation",
        "sbom"
      ]
    }
  }
}

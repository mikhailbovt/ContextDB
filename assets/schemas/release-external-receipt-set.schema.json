{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/release-external-receipt-set/v1.json",
  "title": "ContextDB external release receipt intake set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "subject_manifest",
    "expected_coverage",
    "receipts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.release-external-receipt-set/v1"
    },
    "release_version": {"$ref": "#/$defs/semver"},
    "subject_manifest": {"$ref": "#/$defs/sourceFile"},
    "expected_coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/receipt"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "kind": {
      "enum": [
        "install-receipt",
        "operational-receipt",
        "publication-receipt",
        "provenance-attestation",
        "sbom"
      ]
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "platform"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/kind"},
        "platform": {"$ref": "#/$defs/identifier"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_path",
        "sha256",
        "size_bytes",
        "artifact_id",
        "platform"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/kind"},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "platform": {"$ref": "#/$defs/identifier"},
        "operational_inputs": {"$ref": "#/$defs/operationalInputs"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "operational-receipt"}},
            "required": ["kind"]
          },
          "then": {"required": ["operational_inputs"]},
          "else": {"not": {"required": ["operational_inputs"]}}
        }
      ]
    },
    "operationalInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "old_manifest"],
      "properties": {
        "plan": {"$ref": "#/$defs/sourceFile"},
        "old_manifest": {"$ref": "#/$defs/sourceFile"}
      }
    }
  }
}

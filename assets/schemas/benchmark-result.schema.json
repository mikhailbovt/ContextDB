{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/benchmark-result/v1.json",
  "title": "ContextDB benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "status",
    "benchmark",
    "contextdb",
    "environment",
    "configuration",
    "metrics",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "contextdb.benchmark-result/v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed", "error", "observation_only"]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "name", "version", "dataset_version", "scenario", "tier"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BENCH-[0-9]{4}$"
        },
        "family": {
          "enum": ["BENCH-A", "BENCH-B", "BENCH-C", "BENCH-D", "BENCH-E", "BENCH-F", "BENCH-G", "BENCH-H"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contextdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_manifest", "version_manifest_sha256"],
      "properties": {
        "version_manifest": {
          "$ref": "https://contextdb.dev/schemas/version-manifest/v1.json"
        },
        "version_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "architecture",
        "cpu",
        "logical_cores",
        "memory_bytes",
        "storage",
        "filesystem",
        "rustc",
        "cargo",
        "storage_backend",
        "build_profile"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string"
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logical_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "storage_backend": {
          "type": "string",
          "minLength": 1
        },
        "storage_backend_version": {
          "type": "string"
        },
        "storage_configuration_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_profile": {
          "enum": ["dev", "test", "bench", "release", "release-safe"]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "features", "budgets", "parameters", "index_watermarks"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean"]
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean", "null"]
          }
        },
        "index_watermarks": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "revision", "prompt_versions", "schema_versions", "embedding_spaces"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "prompt_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "schema_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "embedding_spaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "metric", "passed"],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "format": "uri-reference"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": ["error"]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "direction", "observed"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["higher_is_better", "lower_is_better", "target", "informational"]
        },
        "observed": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["count"],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "mean": {
                  "type": "number"
                },
                "p50": {
                  "type": "number"
                },
                "p95": {
                  "type": "number"
                },
                "p99": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "value"],
          "properties": {
            "operator": {
              "enum": ["lt", "lte", "eq", "gte", "gt", "between_inclusive"]
            },
            "value": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          }
        },
        "passed": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "threshold": ["passed"],
        "passed": ["threshold"]
      }
    }
  }
}

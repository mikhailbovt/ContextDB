{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdb.dev/schemas/m16-proof-common/v1.json",
  "title": "ContextDB M16 proof common definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "status": {
      "enum": ["passed", "failed", "error", "observation_only", "incomplete"]
    },
    "frozenInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_manifest_sha256",
        "cargo_lock_sha256",
        "security_source_manifest_sha256"
      ],
      "properties": {
        "workspace_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cargo_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "security_source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "status": {
          "enum": ["passed", "failed", "error", "not_run"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
